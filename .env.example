# ==============================================================================
# F.R.I.D.A.Y. Configuration Template (.env.example)
# All environment variables listed here are verified and supported in code.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Settings
# ------------------------------------------------------------------------------
# Server instance identifier (Default: Friday)
SERVER_NAME=Friday

# Enable debug mode logging (Default: false)
DEBUG=false

# Enable execution sandbox (Default: true)
SANDBOX_ENABLED=true


# ------------------------------------------------------------------------------
# 2. Unified Provider Selection
# ------------------------------------------------------------------------------
# Primary LLM provider (openai | gemini | groq | anthropic | openrouter | ollama)
LLM_PROVIDER=openai

# Vision analysis provider (openai | gemini | ollama | openrouter)
VISION_PROVIDER=openai

# OCR provider (easyocr | paddleocr | google)
OCR_PROVIDER=easyocr

# Text Embedding provider (openai | voyage | jina | cohere)
EMBEDDING_PROVIDER=openai

# Web Search provider (tavily | brave | serper | exa | firecrawl)
SEARCH_PROVIDER=tavily

# Speech-to-Text provider (deepgram | sarvam | whisper | azure)
STT_PROVIDER=deepgram

# Text-to-Speech provider (deepgram | openai | sarvam | azure)
TTS_PROVIDER=deepgram

# Primary Database provider (sqlite)
DATABASE_PROVIDER=sqlite

# Storage provider for key-value / credentials (sqlite)
STORAGE_PROVIDER=sqlite

# Memory system provider (mem0 | builtin)
MEMORY_PROVIDER=mem0


# ------------------------------------------------------------------------------
# 3. Provider Settings & Execution Controls
# ------------------------------------------------------------------------------
# HTTP request timeout in seconds for external providers (Default: 30.0)
PROVIDER_TIMEOUT=30.0

# Retry attempts for failed API requests (Default: 3)
PROVIDER_RETRY_COUNT=3


# ------------------------------------------------------------------------------
# 4. Core AI & LLM Provider Keys
# ------------------------------------------------------------------------------
# OpenAI API key (Get from: https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key

# Google Gemini API key (Get from: https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key

# Groq API key (Get from: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key

# OpenRouter API key (Get from: https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key

# Anthropic Claude API key (Get from: https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key

# ElevenLabs Speech API key (Get from: https://elevenlabs.io)
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Deepgram Speech API key (Get from: https://console.deepgram.com)
DEEPGRAM_API_KEY=your_deepgram_api_key

# Sarvam AI API key (Get from: https://dashboard.sarvam.ai)
SARVAM_API_KEY=your_sarvam_api_key

# Mem0 Vector Memory API key (Get from: https://mem0.ai)
MEM0_API_KEY=your_mem0_api_key

# Local Ollama Host URL (Default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434



# ------------------------------------------------------------------------------
# 6. Web Search & Intelligence Services
# ------------------------------------------------------------------------------
# Tavily Search API key
TAVILY_API_KEY=your_tavily_api_key

# Serper Google Search API key
SERPER_API_KEY=your_serper_api_key

# Brave Search API key
BRAVE_API_KEY=your_brave_api_key

# Exa AI Search API key
EXA_API_KEY=your_exa_api_key

# Firecrawl Web Scraping API key
FIRECRAWL_API_KEY=your_firecrawl_api_key


# ------------------------------------------------------------------------------
# 7. Embeddings, Reranking & Vector Services
# ------------------------------------------------------------------------------
# Voyage AI Embedding API key
VOYAGE_API_KEY=your_voyage_api_key

# Jina AI Embedding API key
JINA_API_KEY=your_jina_api_key

# Cohere Rerank / Embedding API key
COHERE_API_KEY=your_cohere_api_key


# ------------------------------------------------------------------------------
# 8. Storage, Databases & Caching
# ------------------------------------------------------------------------------
# SQLite Storage database relative or absolute path
SQLITE_STORAGE_DB=friday_data/storage.db

# SQLite Database path for core models
SQLITE_DATABASE_DB=friday_data/database.db

# Redis connection URL
REDIS_URL=redis://localhost:6379


# ------------------------------------------------------------------------------
# 9. Additional Tools & Integrations
# ------------------------------------------------------------------------------
# Slack Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=your_slack_bot_token

# Email Integration (SMTP/IMAP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com
EMAIL_USERNAME=your_email@domain.com
EMAIL_PASSWORD=your_app_password

# OpenWeatherMap API Key
OPENWEATHER_KEY=your_openweather_key

# Azure Speech Service Key & Region
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=eastus

# Google GCP Service Account Credentials Path
GOOGLE_APPLICATION_CREDENTIALS=


# ------------------------------------------------------------------------------
# 10. Model Overrides
# ------------------------------------------------------------------------------
# Vision Model Selection (e.g. gpt-4o | gemini-2.5-flash | llava)
VISION_MODEL=gpt-4o

# TTS Model Selection (e.g. tts-1 | tts-1-hd)
TTS_MODEL=tts-1

# TTS Voice Selection (e.g. alloy | echo | fable | onyx | nova | shimmer)
TTS_VOICE=alloy


# ------------------------------------------------------------------------------
# 11. Memory Pipeline
# ------------------------------------------------------------------------------
# Enable context prefetch and post-turn fact extraction (Default: true)
MEMORY_ENABLED=true


# ------------------------------------------------------------------------------
# 12. Perception & System Sensors
# ------------------------------------------------------------------------------
CAMERA_ENABLED=true
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720

SCREEN_ENABLED=true

MICROPHONE_ENABLED=true
MIC_DEVICE=default

CLIPBOARD_ENABLED=true
WINDOW_MONITOR_ENABLED=true
PROCESS_MONITOR_ENABLED=true
BATTERY_MONITOR_ENABLED=true
NETWORK_MONITOR_ENABLED=true
USB_MONITOR_ENABLED=true
WIFI_MONITOR_ENABLED=true
BLUETOOTH_MONITOR_ENABLED=true

FILESYSTEM_ENABLED=true
FILESYSTEM_WATCH_PATHS=
